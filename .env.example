# API キーはここに書く。**モデル指定文字列には絶対に書かない**(シェル履歴とログに残るため)。
# .env は .gitignore 済み。

# Anthropic(anthropic:NAME:MODEL_ID)
ANTHROPIC_API_KEY=

# OpenAI(openai:NAME:MODEL_ID)
OPENAI_API_KEY=

# OpenAI 互換の自前ホスト(compat:NAME:MODEL_ID:BASE_URL)
# ローカルの Ollama / vLLM / LM Studio はキー不要なことが多いので、空でよい。
CONTAMLAB_API_KEY=
